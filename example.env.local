# API keys
AVIATIONSTACK_API_KEY=your_api_key

# Redis configuration
# URL kết nối đến Redis của bạn
REDIS_URL=redis://default:password@host:port

# Cache config
CACHE_TTL_HOURS=10
MAX_API_CALLS_PER_DAY=3

# Giới hạn gọi API được kiểm soát bằng Redis; không dùng NO_LIMIT.

# Mã riêng cho nhân viên khảo sát /bus-collect (đặt giá trị ngẫu nhiên trên Vercel)
BUS_COLLECT_TOKEN=

# Mã riêng chủ trang để duyệt tại /bus-review; không cấp cho nhân viên
BUS_REVIEW_TOKEN=

# GitHub fine-grained token: chỉ repo bxdoan/nhatrang, Contents read/write
GITHUB_BUS_TOKEN=
